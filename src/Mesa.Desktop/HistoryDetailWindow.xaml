<Window x:Class="Mesa.Desktop.HistoryDetailWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mesa · Detalle del cierre" Width="880" Height="680" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,22"><TextBlock Text="CIERRE GUARDADO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock x:Name="TitleText" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,7"/><TextBlock x:Name="SavedText" Foreground="{StaticResource Muted}"/><TextBlock Text="Estos son los productos y precios originales del cierre. El detalle es de solo lectura." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
    <DataGrid Grid.Row="1" x:Name="DetailsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="38" ColumnHeaderHeight="38" BorderBrush="{StaticResource Line}" Background="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Line}" AutomationProperties.Name="Productos del cierre guardado">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="2*"/>
        <DataGridTextColumn Header="Precio unitario" Binding="{Binding Price}" Width="*"/>
        <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="100"/>
        <DataGridTextColumn Header="Importe" Binding="{Binding Amount}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="18" Margin="0,18,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Total de ventas" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="TotalText" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="TaxCaption" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="TaxText" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Unidades vendidas" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="UnitsText" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Grid></Border>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="_Volver" Click="Back_Click" IsCancel="True" MinWidth="110"/><Button Content="_Imprimir resumen" Click="Print_Click" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"/></StackPanel>
  </Grid>
</Window>
