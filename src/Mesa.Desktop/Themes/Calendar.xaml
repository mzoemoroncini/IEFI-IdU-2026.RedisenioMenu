<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
  <!-- Días: selección terracota, hoy con contorno y foco visible. -->
  <Style x:Key="MesaCalendarDay" TargetType="p:CalendarDayButton">
    <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="p:CalendarDayButton"><Border x:Name="Day" CornerRadius="18" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
      <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="#A89E95"/></Trigger>
      <Trigger Property="IsToday" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F4E3DA"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#334F72"/><Setter Property="BorderThickness" Value="2"/></Trigger>
      <Trigger Property="IsBlackedOut" Value="True"><Setter Property="Opacity" Value="0.3"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Meses y años: conservan la navegación por encabezado y teclado. -->
  <Style x:Key="MesaCalendarPeriod" TargetType="p:CalendarButton">
    <Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="48"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="p:CalendarButton"><Border x:Name="Period" CornerRadius="7" Background="{TemplateBinding Background}" Padding="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
      <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="#A89E95"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F4E3DA"/></Trigger>
      <Trigger Property="HasSelectedDays" Value="True"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Period" Property="BorderBrush" Value="#334F72"/><Setter TargetName="Period" Property="BorderThickness" Value="2"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="MesaCalendarNavigation" TargetType="Button"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="24"/><Setter Property="Background" Value="{DynamicResource Soft}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Nav" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Background" Value="#F4E3DA"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="MesaCalendarItem" TargetType="p:CalendarItem">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="p:CalendarItem">
      <ControlTemplate.Resources><DataTemplate x:Key="{x:Static p:CalendarItem.DayTitleTemplateResourceKey}"><TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></ControlTemplate.Resources>
      <Grid x:Name="PART_Root"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
          <Button x:Name="PART_PreviousButton" Content="‹" Style="{StaticResource MesaCalendarNavigation}" Focusable="False" AutomationProperties.Name="Anterior"/>
          <Button x:Name="PART_HeaderButton" Grid.Column="1" Margin="6,0" Padding="8,4" MinHeight="34" Height="34" BorderThickness="0" Background="Transparent" FontWeight="SemiBold" FontSize="14" HorizontalContentAlignment="Center"/>
          <Button x:Name="PART_NextButton" Grid.Column="2" Content="›" Style="{StaticResource MesaCalendarNavigation}" Focusable="False" AutomationProperties.Name="Siguiente"/>
        </Grid>
        <Grid x:Name="PART_MonthView" Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions></Grid>
        <Grid x:Name="PART_YearView" Grid.Row="1" Margin="0,8,0,0" Visibility="Hidden" MinHeight="220"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions></Grid>
      </Grid>
      <ControlTemplate.Triggers><DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Year"><Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Decade"><Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/></DataTrigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="MesaCalendar" TargetType="Calendar">
    <Setter Property="FirstDayOfWeek" Value="Monday"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="CalendarDayButtonStyle" Value="{StaticResource MesaCalendarDay}"/><Setter Property="CalendarButtonStyle" Value="{StaticResource MesaCalendarPeriod}"/><Setter Property="CalendarItemStyle" Value="{StaticResource MesaCalendarItem}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Calendar"><Border x:Name="PART_Root" Background="White" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="14"><p:CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Se mantienen las partes nativas del DatePicker para escritura, validación y accesibilidad. -->
  <Style x:Key="MesaDatePicker" TargetType="DatePicker">
    <Setter Property="CalendarStyle" Value="{StaticResource MesaCalendar}"/><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker"><Grid x:Name="PART_Root">
      <Border x:Name="DateFrame" CornerRadius="8" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="White"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
        <p:DatePickerTextBox x:Name="PART_TextBox" Padding="12,8" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="14" Focusable="True"><p:DatePickerTextBox.Template><ControlTemplate TargetType="p:DatePickerTextBox"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></ControlTemplate></p:DatePickerTextBox.Template></p:DatePickerTextBox>
        <Button x:Name="PART_Button" Grid.Column="1" Width="32" Height="32" MinHeight="0" Padding="7" Margin="0,4,5,4" Background="{DynamicResource Soft}" BorderThickness="0" Focusable="False" ToolTip="Abrir calendario" AutomationProperties.Name="Abrir calendario"><Path Data="M 3,4 L 15,4 L 15,15 L 3,15 Z M 3,7 L 15,7 M 6,2 L 6,5 M 12,2 L 12,5" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" Stretch="Uniform"/></Button>
      </Grid></Border>
      <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="8"/>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DateFrame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DateFrame" Property="BorderBrush" Value="#C8B1A3"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="DateFrame" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
