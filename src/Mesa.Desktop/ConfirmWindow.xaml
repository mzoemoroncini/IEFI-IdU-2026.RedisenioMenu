<Window x:Class="Mesa.Desktop.ConfirmWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mesa · Confirmación" Width="490" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Loaded="Window_Loaded">
  <StackPanel Margin="28">
    <TextBlock Text="CONFIRMACIÓN" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="11"/>
    <TextBlock x:Name="Question" FontSize="21" FontWeight="SemiBold" Margin="0,12,0,12"/>
    <TextBlock x:Name="Explanation" Foreground="{DynamicResource Muted}"/>
    <TextBlock Text="Esc: conservar · Enter: activar el botón enfocado" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,20,0,20"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="KeepButton" Content="_Conservar" IsCancel="True" MinWidth="110"/><Button x:Name="AcceptButton" Content="Sí, limpiar" Style="{StaticResource PrimaryButton}" Click="Accept_Click" Margin="12,0,0,0" MinWidth="110"/></StackPanel>
  </StackPanel>
</Window>
