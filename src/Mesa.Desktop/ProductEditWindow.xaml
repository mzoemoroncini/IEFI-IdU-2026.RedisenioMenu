<Window x:Class="Mesa.Desktop.ProductEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mesa · Producto" Width="500" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ContentRendered="Window_Rendered">
  <StackPanel Margin="28">
    <TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <TextBlock Text="Los cierres del historial conservan sus productos y precios originales." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,20"/>
    <Label Content="_Nombre del producto" Target="{Binding ElementName=NameInput}" Padding="0,0,0,6"/>
    <TextBox x:Name="NameInput" MaxLength="200" AutomationProperties.Name="Nombre del producto"/>
    <TextBlock x:Name="NameError" Foreground="#B42318" FontSize="12" Margin="0,5,0,0" Visibility="Collapsed"/>
    <Label Content="_Precio unitario ($)" Target="{Binding ElementName=PriceInput}" Padding="0,18,0,6"/>
    <TextBox x:Name="PriceInput" MaxLength="20" AutomationProperties.Name="Precio unitario en pesos"/>
    <TextBlock Text="Ejemplo: 6500 o 6500,50. Sin separadores de miles." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
    <TextBlock x:Name="PriceError" Foreground="#B42318" FontSize="12" Margin="0,5,0,0" Visibility="Collapsed"/>
    <TextBlock x:Name="SaveError" Foreground="#B42318" Margin="0,18,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0"><Button Content="_Cancelar" IsCancel="True" MinWidth="110"/><Button Content="_Guardar producto" IsDefault="True" Click="Save_Click" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"/></StackPanel>
  </StackPanel>
</Window>
