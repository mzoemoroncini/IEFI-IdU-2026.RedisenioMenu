<Window x:Class="Mesa.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Mesa.Desktop" Title="Mesa · Gestión de restaurante" Width="1220" Height="800" MinWidth="1050" MinHeight="680" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown" Closing="Window_Closing" Loaded="Window_Loaded" Language="es-AR">
  <Grid Margin="28,24,28,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,26">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="205"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="MESA  /  VENTAS DIARIAS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
        <TextBlock Text="Cierre de ventas del día" FontSize="28" FontWeight="SemiBold" Margin="0,7,0,6"/>
        <TextBlock Text="Ingresá las unidades vendidas de cada producto." Foreground="{StaticResource Muted}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><Label Target="{Binding ElementName=ClosingDate}" Content="_Fecha del cierre" Padding="0,0,0,6" Foreground="{StaticResource Muted}"/>
        <DatePicker x:Name="ClosingDate" SelectedDateFormat="Short" SelectedDateChanged="Date_Changed" DateValidationError="Date_Invalid" LostKeyboardFocus="Date_FocusLost" FontSize="14" Padding="5" AutomationProperties.Name="Fecha del cierre"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="295"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="20,18"><TextBlock Text="Productos vendidos" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="8 productos" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="12"/></Grid>
          <Border Grid.Row="1" Background="{StaticResource Soft}" BorderBrush="{StaticResource Line}" BorderThickness="0,1">
            <Grid Margin="18,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="150"/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions>
              <TextBlock Text="Producto" Foreground="{StaticResource Muted}" FontSize="12"/>
              <TextBlock Grid.Column="1" Text="Precio unitario" TextAlignment="Right" Foreground="{StaticResource Muted}" FontSize="12"/>
              <TextBlock Grid.Column="2" Text="Cantidad vendida" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"/>
              <TextBlock Grid.Column="3" Text="Importe" TextAlignment="Right" Foreground="{StaticResource Muted}" FontSize="12"/>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl x:Name="RowsControl" ItemsSource="{Binding}">
              <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:SaleRow}">
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,12">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="150"/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="Medium"/>
                    <TextBlock Grid.Column="1" Text="{Binding Price}" VerticalAlignment="Center" TextAlignment="Right"/>
                    <StackPanel Grid.Column="2" Margin="10,0">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                        <Button Content="−" Padding="0" MinHeight="34" Height="34" Click="Decrease_Click" Focusable="False" AutomationProperties.Name="{Binding Name, StringFormat=Disminuir cantidad de {0}}"/>
                        <TextBox Grid.Column="1" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" MinHeight="34" MaxLength="12" GotKeyboardFocus="Quantity_Focused" AutomationProperties.Name="{Binding Name, StringFormat=Cantidad vendida de {0}}" AutomationProperties.HelpText="{Binding Error}">
                          <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="BorderBrush" Value="#B42318"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="2" Content="+" Padding="0" MinHeight="34" Height="34" Click="Increase_Click" Focusable="False" AutomationProperties.Name="{Binding Name, StringFormat=Aumentar cantidad de {0}}"/>
                      </Grid>
                      <TextBlock Text="{Binding Error}" Foreground="#B42318" FontSize="11" Margin="0,5,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding Amount}" VerticalAlignment="Center" TextAlignment="Right" FontWeight="Medium"/>
                  </Grid>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Grid.Row="3" Text="Tab / Shift+Tab: navegar  ·  Enter: calcular" Margin="20,13" FontSize="12" Foreground="{StaticResource Muted}"/>
        </Grid>
      </Border>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Border Style="{StaticResource Panel}" Padding="22">
          <StackPanel>
            <TextBlock Text="Resumen del día" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,25"/>
            <TextBlock x:Name="SummaryCaption" Text="Total de ventas" Foreground="{StaticResource Muted}" FontSize="13"/>
            <TextBlock x:Name="TotalValue" Text="$ 0,00" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,20"/>
            <Border Background="{StaticResource Soft}" Padding="13" CornerRadius="5">
              <StackPanel><TextBlock Text="Impuesto · 18 %" Foreground="{StaticResource Muted}" FontSize="13"/><TextBlock x:Name="TaxValue" Text="$ 0,00" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,7"/><TextBlock Text="Calculado sobre el total de ventas. No se suma nuevamente." FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
            </Border>
            <Grid Margin="0,20"><TextBlock Text="Unidades vendidas" FontSize="13"/><TextBlock x:Name="UnitsValue" Text="0" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,16,0,16">
              <TextBlock x:Name="StatusText" Text="Ingresá las cantidades vendidas para calcular." Foreground="{StaticResource Muted}" FontSize="13" MinHeight="42" AutomationProperties.LiveSetting="Polite"/>
            </Border>
            <Button x:Name="CalculateButton" Content="_Calcular ventas" Style="{StaticResource PrimaryButton}" Click="Calculate_Click"/>
            <Button x:Name="ClearButton" Content="_Limpiar cantidades" Margin="0,10,0,0" Click="Clear_Click" IsEnabled="False"/>
            <Button x:Name="PrintButton" Content="_Imprimir resumen" Margin="0,10,0,0" Click="Print_Click" IsEnabled="False" ToolTip="Calculá ventas válidas y actualizadas para imprimir."/>
            <TextBlock Text="Ctrl+P: vista previa de impresión" Margin="0,14,0,0" FontSize="11" Foreground="{StaticResource Muted}"/>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>
    <Grid Grid.Row="2" Margin="0,18,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Moneda: pesos argentinos · Precios de ejemplo" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Grid.Column="1" Text="Impuesto del ejercicio: 18 %" Foreground="{StaticResource Muted}" FontSize="11"/></Grid>
  </Grid>
</Window>
