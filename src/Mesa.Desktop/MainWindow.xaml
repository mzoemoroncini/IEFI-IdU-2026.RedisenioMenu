<Window x:Class="Mesa.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Mesa.Desktop" Title="Mesa · Gestión de restaurante" Width="1220" Height="800" MinWidth="1050" MinHeight="680" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown" Closing="Window_Closing" Loaded="Window_Loaded" Language="es-AR">
  <TabControl x:Name="MainTabs" Margin="28,16,28,0" BorderThickness="0" Background="Transparent" SelectionChanged="Tabs_Changed">
    <TabControl.Resources>
      <Style TargetType="TabItem">
        <Setter Property="Padding" Value="20,11"/><Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
          <Border x:Name="TabBorder" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border>
          <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{StaticResource Soft}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
    </TabControl.Resources>
    <TabItem Header="Cierre del _día">
  <Grid Margin="0,20,0,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,26">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="205"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="MESA  /  VENTAS DIARIAS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
        <TextBlock Text="Cierre de ventas del día" FontSize="28" FontWeight="SemiBold" Margin="0,7,0,6"/>
        <TextBlock Text="Ingresá las unidades vendidas de cada producto." Foreground="{StaticResource Muted}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><Label Target="{Binding ElementName=ClosingDate}" Content="_Fecha del cierre" Padding="0,0,0,6" Foreground="{StaticResource Muted}"/>
        <DatePicker x:Name="ClosingDate" SelectedDateFormat="Short" SelectedDateChanged="Date_Changed" DateValidationError="Date_Invalid" LostKeyboardFocus="Date_FocusLost" FontSize="14" Padding="5" AutomationProperties.Name="Fecha del cierre"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="295"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Panel}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="20,18"><TextBlock Text="Productos vendidos" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="ProductsCount" Text="0 productos" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="12"/></Grid>
          <Border Grid.Row="1" Background="{StaticResource Soft}" BorderBrush="{StaticResource Line}" BorderThickness="0,1">
            <Grid Margin="18,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="150"/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions>
              <TextBlock Text="Producto" Foreground="{StaticResource Muted}" FontSize="12"/>
              <TextBlock Grid.Column="1" Text="Precio unitario" TextAlignment="Right" Foreground="{StaticResource Muted}" FontSize="12"/>
              <TextBlock Grid.Column="2" Text="Cantidad vendida" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"/>
              <TextBlock Grid.Column="3" Text="Importe" TextAlignment="Right" Foreground="{StaticResource Muted}" FontSize="12"/>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl x:Name="RowsControl" ItemsSource="{Binding}">
              <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:SaleRow}">
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,12">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="150"/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="Medium"/>
                    <TextBlock Grid.Column="1" Text="{Binding Price}" VerticalAlignment="Center" TextAlignment="Right"/>
                    <StackPanel Grid.Column="2" Margin="10,0">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                        <Button Content="−" Padding="0" MinHeight="34" Height="34" Click="Decrease_Click" Focusable="False" AutomationProperties.Name="{Binding Name, StringFormat=Disminuir cantidad de {0}}"/>
                        <TextBox Grid.Column="1" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" MinHeight="34" MaxLength="12" GotKeyboardFocus="Quantity_Focused" AutomationProperties.Name="{Binding Name, StringFormat=Cantidad vendida de {0}}" AutomationProperties.HelpText="{Binding Error}">
                          <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="BorderBrush" Value="#B42318"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="2" Content="+" Padding="0" MinHeight="34" Height="34" Click="Increase_Click" Focusable="False" AutomationProperties.Name="{Binding Name, StringFormat=Aumentar cantidad de {0}}"/>
                      </Grid>
                      <TextBlock Text="{Binding Error}" Foreground="#B42318" FontSize="11" Margin="0,5,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding Amount}" VerticalAlignment="Center" TextAlignment="Right" FontWeight="Medium"/>
                  </Grid>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Grid.Row="3" x:Name="QuantityHelp" Text="Tab / Enter: siguiente cantidad  ·  Totales automáticos" Margin="20,13" FontSize="12" Foreground="{StaticResource Muted}"/>
        </Grid>
      </Border>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Border Style="{StaticResource Panel}" Padding="22">
          <StackPanel>
            <TextBlock Text="Resumen del día" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,25"/>
            <TextBlock x:Name="SummaryCaption" Text="Total de ventas" Foreground="{StaticResource Muted}" FontSize="13"/>
            <TextBlock x:Name="TotalValue" Text="$ 0,00" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,20"/>
            <Border Background="{StaticResource Soft}" Padding="13" CornerRadius="5">
              <StackPanel><TextBlock Text="Impuesto · 18 %" Foreground="{StaticResource Muted}" FontSize="13"/><TextBlock x:Name="TaxValue" Text="$ 0,00" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,7"/><TextBlock Text="Calculado sobre el total de ventas. No se suma nuevamente." FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
            </Border>
            <Grid Margin="0,20"><TextBlock Text="Unidades vendidas" FontSize="13"/><TextBlock x:Name="UnitsValue" Text="0" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,16,0,16">
              <TextBlock x:Name="StatusText" Text="Los totales se actualizan mientras cargás las cantidades." Foreground="{StaticResource Muted}" FontSize="13" MinHeight="42" AutomationProperties.LiveSetting="Polite"/>
            </Border>
            <Button x:Name="SaveButton" Content="_Guardar cierre" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsEnabled="False" ToolTip="Guardá el cierre cuando termines de cargar las cantidades."/>
            <Button x:Name="ClearButton" Content="_Limpiar cantidades" Margin="0,10,0,0" Click="Clear_Click" IsEnabled="False"/>
            <Button x:Name="PrintButton" Content="_Imprimir resumen" Margin="0,10,0,0" Click="Print_Click" IsEnabled="False" ToolTip="Disponible cuando hay ventas registradas y las cantidades son válidas."/>
            <TextBlock Text="Ctrl+P: vista previa de impresión" Margin="0,14,0,0" FontSize="11" Foreground="{StaticResource Muted}"/>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>
    <Grid Grid.Row="2" Margin="0,18,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Moneda: pesos argentinos · Precios de ejemplo" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Grid.Column="1" Text="Impuesto del ejercicio: 18 %" Foreground="{StaticResource Muted}" FontSize="11"/></Grid>
  </Grid>
    </TabItem>
    <TabItem Header="_Historial">
      <Grid Margin="0,24,0,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,20"><StackPanel><TextBlock Text="Historial de ventas" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Consultá los cierres guardados de cada día." Margin="0,7,0,0" Foreground="{StaticResource Muted}"/></StackPanel><Button Content="Actualizar" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshHistory_Click"/></Grid>
        <TextBlock Grid.Row="1" x:Name="HistoryStatus" Foreground="{StaticResource Muted}" Margin="0,0,0,14" AutomationProperties.LiveSetting="Polite"/>
        <Border Grid.Row="2" Style="{StaticResource Panel}">
          <Grid>
            <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" BorderThickness="0" Background="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Line}" RowHeaderWidth="0" RowHeight="50" ColumnHeaderHeight="42" SelectionChanged="History_SelectionChanged" MouseDoubleClick="History_DoubleClick" PreviewKeyDown="History_KeyDown" AutomationProperties.Name="Cierres diarios guardados">
              <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{StaticResource Soft}"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Padding" Value="14,10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style></DataGrid.ColumnHeaderStyle>
              <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="Padding" Value="14,12"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style></DataGrid.CellStyle>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha del cierre" Binding="{Binding Date}" Width="*"/>
                <DataGridTextColumn Header="Total de ventas" Binding="{Binding Total}" Width="*"/>
                <DataGridTextColumn Header="Impuesto" Binding="{Binding Tax}" Width="*"/>
                <DataGridTextColumn Header="Unidades" Binding="{Binding Units}" Width="110"/>
                <DataGridTextColumn Header="Guardado el" Binding="{Binding SavedAt}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyHistory" Text="Todavía no hay cierres guardados.&#10;Cargá las cantidades y elegí Guardar cierre para empezar." TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="25" IsHitTestVisible="False"/>
          </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Los cierres se conservan en esta computadora, aunque cierres la aplicación." Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,20,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="HistoryDetailButton" Content="Ver _detalle" IsEnabled="False" Click="HistoryDetail_Click"/><Button x:Name="HistoryPrintButton" Content="_Imprimir" IsEnabled="False" Click="HistoryPrint_Click" Margin="12,0,0,0"/></StackPanel></Grid>
      </Grid>
    </TabItem>
    <TabItem Header="_Menú">
      <Grid Margin="0,24,0,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,20"><StackPanel Margin="0,0,290,0"><TextBlock Text="Menú de productos" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Administrá los productos y precios que usás en los próximos cierres." Margin="0,7,0,0" Foreground="{StaticResource Muted}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Actualizar" Click="MenuRefresh_Click"/><Button x:Name="AddProductButton" Content="_Agregar producto" Click="AddProduct_Click" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"/></StackPanel></Grid>
        <TextBlock Grid.Row="1" x:Name="MenuStatus" Foreground="{StaticResource Muted}" Margin="0,0,0,14" AutomationProperties.LiveSetting="Polite"/>
        <Border Grid.Row="2" Style="{StaticResource Panel}">
          <Grid>
            <DataGrid x:Name="MenuGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" BorderThickness="0" Background="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Line}" RowHeaderWidth="0" RowHeight="50" ColumnHeaderHeight="42" SelectionChanged="Menu_SelectionChanged" MouseDoubleClick="Menu_DoubleClick" PreviewKeyDown="Menu_KeyDown" AutomationProperties.Name="Productos del menú actual">
              <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{StaticResource Soft}"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Padding" Value="14,10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style></DataGrid.ColumnHeaderStyle>
              <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="Padding" Value="14,12"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style></DataGrid.CellStyle>
              <DataGrid.Columns><DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Precio unitario" Binding="{Binding FormattedPrice}" Width="*"/></DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyMenu" Text="No hay productos en el menú.&#10;Elegí Agregar producto para empezar." TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="25" IsHitTestVisible="False"/>
          </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Los cambios actualizan automáticamente el cierre en pantalla. El historial conserva sus productos y precios originales." Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,20,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="EditProductButton" Content="_Editar producto" IsEnabled="False" Click="EditProduct_Click"/><Button x:Name="RemoveProductButton" Content="_Quitar del menú" IsEnabled="False" Click="RemoveProduct_Click" Margin="12,0,0,0"/></StackPanel></Grid>
      </Grid>
    </TabItem>
  </TabControl>
</Window>
