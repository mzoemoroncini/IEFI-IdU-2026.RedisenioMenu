<Window x:Class="Mesa.Desktop.HelpWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mesa · Ayuda" Width="620" Height="620" MinWidth="480" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Loaded="Window_Loaded">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock Text="GUÍA RÁPIDA" Foreground="{DynamicResource AccentInk}" FontWeight="SemiBold" FontSize="11"/><TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><ItemsControl x:Name="Steps"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource Surface}" CornerRadius="10" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="16" Margin="0,0,0,12"><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="14" LineHeight="23"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Teclado: Tab y Mayús+Tab recorren los controles. Enter activa el botón enfocado. Escape cierra la ayuda y las ventanas de confirmación. Si Windows tiene activado un tema de alto contraste, Mesa utiliza los colores del sistema." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,6,0,12"/></StackPanel></ScrollViewer>
    <Button Grid.Row="2" x:Name="CloseHelpButton" Content="_Cerrar ayuda" IsCancel="True" HorizontalAlignment="Right" Margin="0,18,0,0" MinWidth="130"/>
  </Grid>
</Window>
