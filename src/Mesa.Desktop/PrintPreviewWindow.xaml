<Window x:Class="Mesa.Desktop.PrintPreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mesa · Vista previa de impresión" Width="950" Height="800" MinWidth="750" MinHeight="600" WindowStartupLocation="CenterOwner">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,14">
      <DockPanel><Button Content="_Volver" IsCancel="True" Click="Back_Click" DockPanel.Dock="Left"/><Button Content="_Imprimir" Style="{StaticResource PrimaryButton}" Click="Print_Click" DockPanel.Dock="Right" Margin="16,0,0,0"/><TextBlock Text="Vista previa · Resumen de ventas" VerticalAlignment="Center" Margin="20,0" FontSize="17" FontWeight="SemiBold"/></DockPanel>
    </Border>
    <FlowDocumentScrollViewer x:Name="Preview" IsToolBarVisible="True" Margin="20" Background="White" VerticalScrollBarVisibility="Auto" />
  </DockPanel>
</Window>
